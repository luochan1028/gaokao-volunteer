{
  "name": "video-prompts-crawler",
  "version": "1.0.0",
  "description": "视频创作热门提示词抓取系统 —— 每 2 小时抓取 GitHub 高星视频提示词仓库、WaytoAGI 中文提示词库、PromptHero 视频板块，汇总生成 Markdown 报告",
  "main": "src/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/index.js --once",
    "task:install": "node src/index.js --install-task",
    "task:remove": "node src/index.js --remove-task",
    "task:status": "node src/index.js --task-status"
  },
  "keywords": [
    "prompt",
    "video",
    "crawler",
    "sora",
    "kling",
    "定时任务"
  ],
  "license": "MIT"
}